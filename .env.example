# Application
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Database (PostgreSQL)
DATABASE_URL=
# Maximum pooled connections. Each in-flight request needs one connection;
# a request that holds a transaction must not open a second one.
DATABASE_POOL_MAX=20

# Clerk authentication
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# Cloudflare R2 object storage
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# SendByte transactional email
SENDBYTE_API_KEY=
EMAIL_FROM=

# Workspace OAuth apps. Generate a stable key: openssl rand -base64 32
# Never rotate the key without re-encrypting existing integration secrets.
INTEGRATION_ENCRYPTION_KEY=
SLACK_CLIENT_ID=
SLACK_CLIENT_SECRET=
DISCORD_CLIENT_ID=
DISCORD_CLIENT_SECRET=

# Root domain for public workspace subdomains, without scheme or www.
# Configure wildcard DNS, TLS and hosting for *.feedback.riftlabs.xyz before enabling.
# NEXT_PUBLIC_WORKSPACE_BASE_DOMAIN=feedback.riftlabs.xyz

# Protect /api/internal/notification-jobs (at least 32 random characters)
CRON_SECRET=

# Bachs subscription billing. Use sandbox keys first; never expose secret keys to the browser.
BACHS_API_KEY=
BACHS_WEBHOOK_SECRET=
BACHS_ORGANIZATION_ID=
# USD 7/month and USD 70/year, each with an included 14-day trial.
BACHS_MONTHLY_PRODUCT_ID=
BACHS_YEARLY_PRODUCT_ID=

# Optional public HTTPS checkout return origin for local tunnel testing
BACHS_RETURN_ORIGIN=

# Optional PostHog product analytics (project token only, never a personal API key).
# No collection until browser consent. Production only unless explicitly enabled below.
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com
NEXT_PUBLIC_POSTHOG_ENABLE_IN_DEVELOPMENT=false

# Ent Mintlify project origin only; configure its custom domain as ent.riftlabs.xyz/docs.
MINTLIFY_ORIGIN=

# Lifecycle welcome/setup/inactivity emails. Enable after migration and sandbox checks.
LIFECYCLE_EMAILS_ENABLED=false
EMAIL_UNSUBSCRIBE_SECRET=
