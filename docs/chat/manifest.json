{
  "display_information": {
    "name": "Ent",
    "description": "Manage feedback and live chat conversations from Slack.",
    "background_color": "#212529"
  },
  "features": {
    "bot_user": {
      "display_name": "Ent",
      "always_online": false
    }
  },
  "oauth_config": {
    "redirect_urls": [
      "https://ent.riftlabs.xyz/api/integrations/slack/callback"
    ],
    "scopes": {
      "bot": [
        "incoming-webhook",
        "chat:write",
        "channels:history",
        "groups:history",
        "users:read",
        "users:read.email",
        "files:read"
      ]
    }
  },
  "settings": {
    "event_subscriptions": {
      "request_url": "https://ent.riftlabs.xyz/api/integrations/slack/events",
      "bot_events": [
        "message.channels",
        "message.groups"
      ]
    },
    "interactivity": {
      "is_enabled": true,
      "request_url": "https://ent.riftlabs.xyz/api/integrations/slack/events"
    },
    "org_deploy_enabled": false,
    "socket_mode_enabled": false,
    "token_rotation_enabled": false
  }
}
