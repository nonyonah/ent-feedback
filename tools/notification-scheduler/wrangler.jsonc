{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "ent-notification-scheduler",
  "main": "src/index.ts",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": ["nodejs_compat"],
  "workers_dev": false,
  "observability": {"enabled": true, "head_sampling_rate": 1},
  "triggers": {"crons": ["* * * * *"]},
  "vars": {"APP_ORIGIN": "https://ent.riftlabs.xyz", "ENABLED": "false"},
  "secrets": {"required": ["CRON_SECRET"]}
}
